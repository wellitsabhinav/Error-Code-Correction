(DELAYFILE
 (SDFVERSION "3.0")
 (DESIGN "hazard_dut")
 (DIVIDER /)
 (VOLTAGE 1.8:1.8:1.8)
 (TEMPERATURE 25:25:25)
 (TIMESCALE 1ps)
 (CELL (CELLTYPE "sky130_fd_sc_hd__buf_1") (INSTANCE u_fast)
  (DELAY (ABSOLUTE (IOPATH A X (100:200:300) (100:200:300)))))
 (CELL (CELLTYPE "sky130_fd_sc_hd__buf_1") (INSTANCE u_slow)
  (DELAY (ABSOLUTE (IOPATH A X (1000:2000:3000) (1000:2000:3000)))))
 (CELL (CELLTYPE "sky130_fd_sc_hd__xor2_1") (INSTANCE u_xor)
  (DELAY (ABSOLUTE (IOPATH A X (50:100:150) (50:100:150))
                   (IOPATH B X (50:100:150) (50:100:150)))))
)
